{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^(req|res|next)$" }],
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["public/js/**/*.js"],
      "env": { "browser": true, "node": false }
    },
    {
      "files": ["tests/**/*.js"],
      "env": { "node": true },
      "parserOptions": { "sourceType": "module" }
    }
  ]
}
