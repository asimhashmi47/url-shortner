# Server
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/urls.db

# Bulk limits
BULK_MAX_URLS=100

# Rate limiting (per client IP, per window): writes = create/bulk/delete, export = Excel download
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
RATE_LIMIT_EXPORT_MAX=10

# Reverse proxy: number of proxy hops in front of the app (e.g. 1 on most
# PaaS hosts). Leave unset when clients connect directly.
# TRUST_PROXY=1
